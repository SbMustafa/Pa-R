# Modèle à copier en ".env" à la racine du projet, puis à compléter.
# Sans ce fichier, l'application envoie ses mails vers Mailpit (http://localhost:8025).

# SMTP réel (exemple Gmail) — MAIL_PASSWORD doit être un mot de passe d'application
# Google (16 caractères, https://myaccount.google.com/apppasswords), pas le mot de
# passe du compte, que le SMTP de Gmail refuse.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=adresse@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=adresse@gmail.com
MAIL_FROM_NAME=NO MORE WASTE
