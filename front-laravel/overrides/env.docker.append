API_BASE_URL=http://api-go:8080/api
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=no_more_waste
DB_USERNAME=nmw
DB_PASSWORD=nmw_password
# Valeurs de repli pour le développement : les mails partent dans Mailpit
# (http://localhost:8025). Le vrai SMTP est injecté par docker-compose.yml depuis
# le fichier .env de la racine du projet, et les variables d'environnement du
# conteneur sont prioritaires sur ce fichier .env interne à Laravel.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=contact@nomorewaste.fr
MAIL_FROM_NAME="NO MORE WASTE"
